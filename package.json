{
  "name": "anda-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/transcript-ingestion.integration.test.ts tests/integration/manual-transcript-upload.integration.test.ts tests/integration/meeting-analysis-persistence.integration.test.ts tests/integration/pre-approval-workflow.integration.test.ts tests/integration/pre-approval-workflow.ui.integration.test.ts tests/integration/meeting-review.integration.test.ts tests/integration/meeting-api.integration.test.ts tests/integration/meeting-approval-pdf.integration.test.ts tests/integration/meeting-signing.integration.test.ts tests/integration/operational-recovery.integration.test.ts tests/integration/property-centre.integration.test.ts",
    "test:properties": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/shared/property-contract.test.ts tests/backend/property-service.test.ts tests/backend/supabase-property-repository.test.ts tests/api/property-api.test.ts tests/frontend/property-centre.test.tsx tests/integration/property-centre.integration.test.ts",
    "test:api:http": "node --env-file-if-exists=.env.local scripts/run-meeting-api-http-smoke.mjs",
    "test:workflow": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/pre-approval-workflow.integration.test.ts",
    "test:workflow:ui": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/pre-approval-workflow.ui.integration.test.ts",
    "test:reviews": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/meeting-review.integration.test.ts",
    "test:approval": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/meeting-approval-pdf.integration.test.ts",
    "test:signing": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/meeting-signing.integration.test.ts",
    "test:archive": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/backend/process-meeting-archive.test.ts tests/backend/process-firma-archive-workflow.test.ts tests/backend/meeting-archive-service.test.ts tests/backend/supabase-meeting-archive-repository.test.ts tests/backend/supabase-minutes-pdf-storage.test.ts tests/api/meeting-archive.test.ts tests/integration/meeting-signing.integration.test.ts",
    "test:operations": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/backend/operational-alerts.test.ts tests/backend/run-operational-recovery.test.ts tests/backend/supabase-operational-alert-repository.test.ts tests/api/operational-recovery.test.ts tests/integration/operational-recovery.integration.test.ts tests/integration/meeting-signing.integration.test.ts",
    "test:operations:live:telegram": "node --env-file-if-exists=.env.local scripts/run-live-telegram-alert-test.mjs",
    "test:signing:live:webhook": "node --env-file-if-exists=.env.local scripts/run-live-signing-callback-test.mjs --preflight-only",
    "test:signing:live:callback": "node --env-file-if-exists=.env.local scripts/run-live-signing-callback-test.mjs",
    "test:signing:live:frontend": "node --env-file-if-exists=.env.local scripts/run-live-signing-callback-test.mjs --manual-frontend",
    "test:workflow:live": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/pre-approval-workflow.live.integration.test.ts",
    "test:workflow:live:full": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/full-workflow.live.integration.test.ts",
    "test:openai": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/openai-connection.integration.test.ts",
    "test:openai:analysis": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/openai-transcript-analysis.integration.test.ts",
    "test:transcript:manual": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/manual-transcript-upload.integration.test.ts",
    "test:transcript:manual:live": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/manual-transcript-upload.live.integration.test.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "mock:transcript": "node --env-file-if-exists=.env.local scripts/mock-transcript/send-dummy-transcript.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:env": "node scripts/write-local-supabase-env.mjs",
    "supabase:reset": "supabase db reset",
    "supabase:seed:ux": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run tests/integration/ux-fixtures.integration.test.ts",
    "supabase:migration:new": "supabase migration new"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^29.1.1",
    "supabase": "2.109.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
