# Copy this file to .env.local and replace every placeholder before running the app.
# Do not commit .env.local or put real credentials in this example file.

# Local Supabase defaults. Replace these values in the hosting provider for
# staging and production. Never expose the secret key to browser code.
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SECRET_KEY=replace-with-local-secret-key

# Receiver used by the dummy transcript sender script. HTTP is valid for localhost.
MOCK_TRANSCRIPT_WEBHOOK_URL=http://localhost:3000/api/webhooks/transcripts
TRANSCRIPT_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Server-only OpenAI configuration. Never expose this key through NEXT_PUBLIC_*.
OPENAI_API_KEY=replace-with-an-openai-project-key
OPENAI_MODEL=gpt-4.1

# Server-only bearer token for POST /api/internal/meetings/{meetingId}/analysis.
# Send this value in the Authorization header as: Bearer <secret>
INTERNAL_ANALYSIS_SECRET=replace-with-a-long-random-internal-secret

# Server-only Firma signing configuration. The test signer is used until the
# active Treasurer is supplied by the accounts workflow.
FIRMA_API_KEY=replace-with-a-firma-workspace-api-key
SIGNING_TEST_SIGNER_FIRST_NAME=Test
SIGNING_TEST_SIGNER_LAST_NAME=Treasurer
SIGNING_TEST_SIGNER_EMAIL=treasurer@example.test
